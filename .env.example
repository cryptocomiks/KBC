# ---------------------------------------------------------------------------
# KBC — Corporate Mapping configuration
# Copy to `.env` and fill in the keys you have. A connector whose key is
# missing is simply disabled (a clear message is shown in the UI).
# ---------------------------------------------------------------------------

# Fictitious demo dataset (searchable side by side with real data, never mixed).
DEMO_MODE=true
# Real public sources. Keyless ones (data.gouv.fr company directory, ICIJ
# Offshore Leaks API) are on by default; keyed ones turn on when their key is set.
LIVE_SOURCES=true
# Wall-clock budget of one investigation (serverless hosts have time limits)
# EXPANSION_TIME_BUDGET_SECONDS=150  # + 60 s for screening, within the 300 s Vercel maxDuration

# SQLite cache location (defaults to ./data/kbc_cache.db, /tmp on Vercel)
# CACHE_PATH=./data/kbc_cache.db
# Cache time-to-live for raw API responses, in hours
CACHE_TTL_HOURS=72

# --- Real data sources -----------------------------------------------------
# Pappers (France) — https://www.pappers.fr/api
PAPPERS_API_KEY=
# OpenCorporates — https://api.opencorporates.com
OPENCORPORATES_API_TOKEN=
# Companies House (UK) — https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# OCCRP Aleph — https://aleph.occrp.org (profile > API key)
ALEPH_API_KEY=
# OpenSanctions — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=
# No key needed: data.gouv.fr "Recherche d'entreprises" (FR) and the ICIJ
# Offshore Leaks reconciliation API (Panama / Paradise / Pandora Papers...).
# ICIJ Offshore Leaks — optional full local copy built by scripts/import_icij.py
ICIJ_DB_PATH=./data/icij_offshore_leaks.db

# --- Cases, analyst decisions and monitoring ----------------------------------
# Password protecting cases and the dashboard (mandatory on Vercel to enable cases).
APP_PASSWORD=
# Secret used by the daily monitoring job (Vercel Cron + GitHub "Case monitoring" workflow).
CRON_SECRET=
# Durable storage. On Vercel: Storage → Create Database (Postgres / Neon) injects it for you.
# Empty = local SQLite file (data/kbc_store.db).
DATABASE_URL=
