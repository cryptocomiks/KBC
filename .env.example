# ---------------------------------------------------------------------------
# KBC — Corporate Mapping configuration
# Copy to `.env` and fill in the keys you have. A connector whose key is
# missing is simply disabled (a clear message is shown in the UI).
# ---------------------------------------------------------------------------

# true  -> only the fictitious demo dataset is used (no API key needed)
# false -> the real connectors whose keys are present are used
DEMO_MODE=true

# SQLite cache location (defaults to ./data/kbc_cache.db, /tmp on Vercel)
# CACHE_PATH=./data/kbc_cache.db
# Cache time-to-live for raw API responses, in hours
CACHE_TTL_HOURS=72

# --- Real data sources -----------------------------------------------------
# Pappers (France) — https://www.pappers.fr/api
PAPPERS_API_KEY=
# OpenCorporates — https://api.opencorporates.com
OPENCORPORATES_API_TOKEN=
# Companies House (UK) — https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# OCCRP Aleph — https://aleph.occrp.org (profile > API key)
ALEPH_API_KEY=
# OpenSanctions — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=
# ICIJ Offshore Leaks — path to the SQLite file built by scripts/import_icij.py
ICIJ_DB_PATH=./data/icij_offshore_leaks.db
