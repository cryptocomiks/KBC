{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- api backend/app config frontend requirements.txt vercel.json .vercelignore",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,config/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/monitor/run",
      "schedule": "17 6 * * *"
    }
  ]
}
